# ==============================================================================
# DERMADUPE LAB - MONETIZATION & AFFILIATE CONFIGURATION
# ==============================================================================
# Copy this file to .env.local or configure in your deployment dashboard (Vercel, Supabase, Railway).

# ------------------------------------------------------------------------------
# 0. FREE AI ENGINE (Google Gemini Flash via Google AI Studio)
# ------------------------------------------------------------------------------
# Get your 100% Free API key at: https://aistudio.google.com
# Generates dynamic real-time luxury formula deconstruction and drugstore dupe matching.
# 1,500 requests/day free, no credit card required.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Sign up at: https://supabase.com
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-supabase-password@db.your-project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AMAZON ASSOCIATES PROGRAM
# ------------------------------------------------------------------------------
# Register at: https://affiliate-program.amazon.com
# Provides up to 10% commission on beauty, skincare, and luxury cosmetic sales.
# The tracking ID usually ends with -20 (e.g., yoursite-20).
AMAZON_ASSOCIATE_TAG="dermadupe-20"

# ------------------------------------------------------------------------------
# 3. SKIMLINKS (Universal Merchant Monetization)
# ------------------------------------------------------------------------------
# Register at: https://hub.skimlinks.com
# Recommended for beauty sites: Automatically monetizes outbound links to 48,000+
# retailers including Sephora, Ulta, Cult Beauty, Space NK, and individual brand sites
# with a single publisher ID.
SKIMLINKS_ID="123456X1600000"

# ------------------------------------------------------------------------------
# 4. IMPACT RADIUS (Target & Beauty Partners)
# ------------------------------------------------------------------------------
# Register at: https://impact.com
# Powers Target Partners, Ulta Beauty, and direct DTC skincare brands.
IMPACT_RADIUS_ID="TARGET_PARTNER_12345"

# ------------------------------------------------------------------------------
# 5. SEPHORA AFFILIATE NETWORK
# ------------------------------------------------------------------------------
# Register through Rakuten Advertising (LinkShare) or direct Sephora Affiliate program.
# https://www.sephora.com/beauty/affiliates
SEPHORA_AFFILIATE_ID="SEPHORA_AFF_67890"

# ------------------------------------------------------------------------------
# 6. SITE CANONICAL URL & GOOGLE SEARCH CONSOLE
# ------------------------------------------------------------------------------
# Used for dynamic sitemap generation and Schema.org rich snippets.
NEXT_PUBLIC_SITE_URL="https://dermadupe.com"

# Google Search Console Domain Verification Token
# Obtain from: https://search.google.com/search-console
# Paste the content string from <meta name="google-site-verification" content="..." />
NEXT_PUBLIC_GSC_VERIFICATION="your-google-verification-code-here"
